[
 {
  "id": "court",
  "name": "AI 模拟法庭",
  "description": "一场真实的纠纷，双方律师各执一词，证人登场，陪审团投票。你可以当法官，也可以当旁听。",
  "cover": null,
  "engineType": "debate",
  "minPlayers": 4,
  "maxPlayers": 6,
  "maxRounds": 2,
  "userRole": "spectator",
  "topicPool": [
   "证据比口才重要，但口才能让证据被看见",
   "先定议题的人占优势",
   "陪审团只记得住最清楚的那一句",
   "反对不是为了打断，是为了留印象"
  ],
  "rules": [
   "按开庭、陈述、答辩、举证、交叉询问、结案陈词、判决的顺序进行",
   "每一方发言必须落到具体证据或具体事实，不许喊口号",
   "可以提出反对，由法官裁定成立或不成立",
   "法官不参与投票，只维持秩序和宣判",
   "陪审团只根据庭上表现投票，不看当事人身份",
   "禁止人身攻击，禁止提及真实人物和真实案件",
   "禁止列举具体法条编号，用常识和逻辑说服人"
  ],
  "phases": [
   {
    "key": "opening",
    "name": "开庭",
    "mode": "narration",
    "actors": "host",
    "narration": "现在开庭，全体起立",
    "allowActions": null
   },
   {
    "key": "plaintiff",
    "name": "原告陈述",
    "mode": "sequential",
    "actors": "plaintiff",
    "narration": null,
    "allowActions": [
     "speak"
    ]
   },
   {
    "key": "defendant",
    "name": "被告答辩",
    "mode": "sequential",
    "actors": "defendant",
    "narration": null,
    "allowActions": [
     "speak"
    ]
   },
   {
    "key": "evidence",
    "name": "举证",
    "mode": "sequential",
    "actors": "lawyers",
    "narration": "双方开始举证",
    "allowActions": [
     "present_evidence"
    ]
   },
   {
    "key": "cross_examination",
    "name": "交叉询问",
    "mode": "sequential",
    "actors": "witness",
    "narration": "证人上场",
    "allowActions": [
     "question",
     "objection",
     "speak"
    ]
   },
   {
    "key": "closing",
    "name": "结案陈词",
    "mode": "sequential",
    "actors": "lawyers",
    "narration": "最后陈述",
    "allowActions": [
     "speak"
    ]
   },
   {
    "key": "verdict",
    "name": "判决",
    "mode": "vote",
    "actors": "jury",
    "narration": "陪审团开始评议",
    "allowActions": [
     "vote"
    ]
   }
  ],
  "roles": [
   {
    "key": "judge",
    "name": "法官",
    "camp": "judge",
    "count": 1,
    "isAi": true,
    "identity": "法官，维持庭审秩序并做出最终宣判",
    "goal": "让双方都有机会说清，最后给出一个站得住脚的判决",
    "personality": "沉稳、不轻易打断、开口就是结论",
    "model": "qwen-plus"
   },
   {
    "key": "plaintiff_lawyer",
    "name": "原告律师",
    "camp": "plaintiff",
    "count": 1,
    "isAi": true,
    "identity": "原告方代理律师",
    "goal": "证明对方有过错，让陪审团站在你这边",
    "personality": "锋利、擅长抓细节、会用反问压制",
    "model": "deepseek-chat"
   },
   {
    "key": "defendant_lawyer",
    "name": "被告律师",
    "camp": "defendant",
    "count": 1,
    "isAi": true,
    "identity": "被告方代理律师",
    "goal": "打掉对方的证据链，或者把责任分摊出去",
    "personality": "冷静、擅长偷换概念、会抓程序问题",
    "model": "deepseek-chat"
   },
   {
    "key": "witness",
    "name": "证人",
    "camp": "witness",
    "count": 1,
    "isAi": true,
    "identity": "当事双方的证人，知道一部分事实",
    "goal": "如实回答，但你只记得自己看到的那部分",
    "personality": "紧张、记性一般、被追问时会补充细节",
    "model": "gpt-4o-mini"
   },
   {
    "key": "jury",
    "name": "陪审员",
    "camp": "jury",
    "count": 2,
    "isAi": true,
    "identity": "陪审团成员，不参与辩论，只负责判断",
    "goal": "根据庭上表现和证据投票，不受情绪影响",
    "personality": "公道、话不多、看重逻辑是否自洽",
    "model": "gemini-flash"
   }
  ],
  "uiSchema": {
   "theme": "noir",
   "accent": "#5fd0f5",
   "bubbleStyle": "court",
   "showSeats": true,
   "systemMessageStyle": "center",
   "actions": [
    {
     "key": "speak",
     "label": "发言",
     "kind": "text",
     "placeholder": "庭审发言，记得引用证据",
     "when": {
      "phase": [
       "opening",
       "plaintiff",
       "defendant",
       "cross_examination",
       "closing"
      ]
     }
    },
    {
     "key": "present_evidence",
     "label": "提交证据",
     "kind": "text",
     "placeholder": "写证据名称",
     "when": {
      "phase": [
       "evidence"
      ]
     }
    },
    {
     "key": "objection",
     "label": "反对",
     "kind": "text",
     "placeholder": "反对理由",
     "when": {
      "phase": [
       "evidence",
       "cross_examination"
      ]
     }
    },
    {
     "key": "vote",
     "label": "投票",
     "kind": "pick_option",
     "options": [
      {
       "value": "plaintiff",
       "label": "支持原告"
      },
      {
       "value": "defendant",
       "label": "支持被告"
      }
     ],
     "when": {
      "phase": [
       "verdict"
      ]
     }
    }
   ]
  }
 },
