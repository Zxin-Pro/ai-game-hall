# ---------- 基础 ----------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
PUBLIC_BASE_URL=http://127.0.0.1:8787

# ---------- 数据库 ----------
DATABASE_URL=postgres://gameroom:gameroom@127.0.0.1:5432/gameroom
REDIS_URL=redis://127.0.0.1:6379

# ---------- 认证 ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# 内测邀请码，逗号分隔；留空则关闭邀请码校验
INVITE_CODES=BETA2026

# ---------- 主模型供应商（OpenAI 兼容） ----------
MODEL_PROVIDER_URL=https://your-cheap-provider.com/v1
MODEL_PROVIDER_KEY=sk-xxx
MODEL_LIST=gpt-4o-mini,claude-haiku,deepseek-chat,qwen-plus,gemini-flash

DEFAULT_SPEAK_MODEL=deepseek-chat
DEFAULT_JUDGE_MODEL=qwen-plus
DEFAULT_SUMMARY_MODEL=gpt-4o-mini

# ---------- 备用供应商（主挂了才用） ----------
FALLBACK_PROVIDER_URL=
FALLBACK_PROVIDER_KEY=

# ---------- 成本控制 ----------
MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT_MS=30000
LLM_RETRY=2
CONTEXT_MESSAGE_WINDOW=20
MAX_CONCURRENT_ROOMS=100

# 全局日预算告警（只告警不自动停服），单位：千 token
DAILY_TOKEN_BUDGET_K=3000
BUDGET_ALERT_WEBHOOK=

# ---------- 文件存储 ----------
UPLOAD_DIR=./data/uploads
